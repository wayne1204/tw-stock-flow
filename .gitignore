# Raw TWSE response cache — ~2,800 small files, fully reproducible by re-running
# pipeline/fetch_data.py. Delete it and the next run refetches (slowly); keep it and
# re-runs finish in seconds.
web/data/raw/

# Per-stock outputs of pipeline/fetch_stocks.py. Built and deployed from the machine
# that runs the fetch (run.sh deploy uploads them from disk), so they never
# need to be in git. Rebuild with `python3 pipeline/fetch_stocks.py`.
web/data/stocks/

# Build artifacts of the fetcher
fetch.log
fetch_stocks.log
__pycache__/
*.pyc

# Test-only dev dependencies (jsdom + echarts, for the page tests in tests/js/).
# The dashboard itself needs none of this.
node_modules/
package-lock.json

# Generated single-file build (rebuild with `python3 pipeline/bundle.py`)
dist/
vendor/

# Editor/local
*.swp
.claude/settings.local.json

# Cron lock for scripts/update_data.sh
.update_data.lock

# Cloudflare credentials for ./run.sh deploy
.env
web/data/.fetch_stocks.lock
.wrangler/
.venv/
